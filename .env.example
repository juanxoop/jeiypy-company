# ───────────────────────────────────────────────────────────────
# Jeipy Company · variables de entorno
# Copia este archivo como .env.local para desarrollo y configura
# las mismas variables en Vercel → Project → Settings → Environment Variables.
# Solo las variables con prefijo NEXT_PUBLIC_ llegan al navegador.
# ───────────────────────────────────────────────────────────────

# URL pública del sitio (SEO, sitemap). Opcional en Vercel.
NEXT_PUBLIC_SITE_URL=https://tu-dominio.com

# WhatsApp del equipo (público: aparece en los enlaces wa.me).
# Formato internacional sin "+" ni espacios, p. ej. 57 + número de 10 dígitos.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ── Leads de Jeipy AI (solo servidor) ──────────────────────────
# Flujo: nuevo lead → Supabase → bandeja /admin/leads → correo (opcional).

# Supabase (https://supabase.com) → Project Settings → API. OBLIGATORIO para guardar leads.
# Ejecuta supabase/leads.sql en el SQL Editor (crea/actualiza las tablas leads y lead_notes).
SUPABASE_URL=
# Clave "service_role" (secreta). Nunca la uses con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── Bandeja privada /admin/leads (solo servidor) ───────────────
# Contraseña del equipo (mínimo 10 caracteres).
ADMIN_PASSWORD=
# Secreto para firmar las sesiones (mínimo 32 caracteres aleatorios).
# Genera uno con: openssl rand -base64 48
ADMIN_SESSION_SECRET=

# ── Aviso por correo (opcional) ────────────────────────────────
# Si falta, los leads igual quedan guardados en la bandeja.
# Correo(s) del equipo que reciben el aviso. Varios separados por coma.
JEIPY_LEADS_EMAIL=
# Resend (https://resend.com) → API Keys.
RESEND_API_KEY=
# Remitente verificado en Resend, p. ej. "Jeipy AI <leads@tudominio.com>".
# Si se deja vacío se usa onboarding@resend.dev, que solo entrega al correo de tu cuenta de Resend.
LEADS_EMAIL_FROM=
