# ───────────────────────────────────────────────────────────────
# Jeipy Company · variables de entorno
# Copia este archivo como .env.local para desarrollo y configura
# las mismas variables en Vercel → Project → Settings → Environment Variables.
# Solo las variables con prefijo NEXT_PUBLIC_ llegan al navegador.
# ───────────────────────────────────────────────────────────────

# URL pública del sitio (SEO, sitemap). Opcional en Vercel.
NEXT_PUBLIC_SITE_URL=https://tu-dominio.com

# WhatsApp del equipo (público: aparece en los enlaces wa.me).
# Formato internacional sin "+" ni espacios, p. ej. 57 + número de 10 dígitos.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ── Leads de Jeipy AI (solo servidor) ──────────────────────────

# Correo(s) del equipo que reciben cada lead. Varios separados por coma.
JEIPY_LEADS_EMAIL=

# Resend (https://resend.com) → API Keys.
RESEND_API_KEY=
# Remitente verificado en Resend, p. ej. "Jeipy AI <leads@tudominio.com>".
# Si se deja vacío se usa onboarding@resend.dev, que solo entrega al correo de tu cuenta de Resend.
LEADS_EMAIL_FROM=

# Supabase (https://supabase.com) → Project Settings → API.
# Ejecuta supabase/leads.sql una vez para crear la tabla.
SUPABASE_URL=
# Clave "service_role" (secreta). Nunca la uses con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Opcional: nombre de la tabla (por defecto "leads").
SUPABASE_LEADS_TABLE=

# Opcional: "file" guarda los leads en .data/leads.jsonl (solo desarrollo local).
# En `next dev` se usa automáticamente si no hay Supabase configurado.
LEADS_STORE=
